# ============================================
# HypnoRaffle Environment Configuration
# Copy this file to .env.local and fill in values
# ============================================

# --------------------------------------------
# Neon (the database the deployed site uses)
# --------------------------------------------
# Base URL of the Neon database, served over https (host + database name).
# The app uses the Neon Data API with anonymous tokens; see docs/neon/schema.sql.
# Example: https://ep-example-123456.c-2.eu-central-1.aws.neon.tech/neondb
NEXT_PUBLIC_NEON_URL=

# Optional: stop live participant polling after this many ms with no input
# and no change (default 600000 = 10 minutes). Only for testing.
# NEXT_PUBLIC_POLL_IDLE_MS=

# --------------------------------------------
# Database Configuration (self-hosted Docker only)
# --------------------------------------------
POSTGRES_USER=hypnoraffle
POSTGRES_PASSWORD=change_this_secure_password_123!
POSTGRES_DB=hypnoraffle

# --------------------------------------------
# PostgREST / API Configuration
# --------------------------------------------
# URL for the PostgREST API (from browser perspective)
NEXT_PUBLIC_POSTGREST_URL=http://localhost:3001

# JWT Secret for PostgREST authentication
# IMPORTANT: Generate a secure secret for production (min 32 chars)
# You can generate one with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars!!

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:9002,http://localhost:3000

# --------------------------------------------
# Site Authentication (HTTP Basic Auth)
# --------------------------------------------
# Set these to enable password protection on the entire site
# Leave empty to disable auth (for local development)
SITE_AUTH_USERNAME=admin
SITE_AUTH_PASSWORD=change_this_secure_password

# --------------------------------------------
# Client-Side Password Protection (for GitHub Pages / Static Sites)
# --------------------------------------------
# SHA-256 hash of your password. Generate with:
#   echo -n "your-password" | openssl dgst -sha256
# Leave empty to disable password protection
NEXT_PUBLIC_SITE_PASSWORD_HASH=

# --------------------------------------------
# Application Configuration
# --------------------------------------------
# Public URL of your application
NEXT_PUBLIC_APP_URL=http://localhost:9002
PUBLIC_URL=http://localhost:9002

# Optional: Webhook URL for winner notifications
NEXT_PUBLIC_WINNER_WEBHOOK_URL=

# --------------------------------------------
# Cloudflare Tunnel (Optional - for internet access)
# --------------------------------------------
# Get this from: https://one.dash.cloudflare.com/
# Create a tunnel and copy the token
CLOUDFLARE_TUNNEL_TOKEN=

